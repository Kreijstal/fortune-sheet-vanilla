{
  "name": "fortune-sheet-vanilla",
  "version": "0.1.0",
  "description": "Excel / Google Sheets-style spreadsheet for the browser. React-free and TypeScript-free fork of ruilisi/fortune-sheet: engine + formula parser + vanilla UI shell in one package.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "browser": "dist/fortune-sheet.vanilla.min.js",
  "types": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./formula-parser": "./src/formula-parser/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": "https://github.com/kreijstal/fortune-sheet-vanilla",
  "keywords": [
    "spreadsheet",
    "sheet",
    "excel",
    "datatable",
    "table",
    "data grid",
    "vanilla",
    "javascript",
    "no-react",
    "no-typescript"
  ],
  "scripts": {
    "build": "node build.mjs",
    "demo": "node build.mjs && npx -y serve demo -l 8080",
    "test": "node test/exports.mjs && node test/smoke.mjs",
    "fix-imports": "node scripts/fix-imports.mjs"
  },
  "dependencies": {
    "@formulajs/formulajs": "^2.9.3",
    "dayjs": "^1.11.0",
    "immer": "^9.0.12",
    "lodash": "^4.17.21",
    "numeral": "^2.0.6",
    "tiny-emitter": "^2.1.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.19.5",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2"
  }
}
